# Скопируйте значения в Railway → Service → Variables.
# Не публикуйте настоящий токен в GitHub.

BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
ADMIN_CHANNEL_ID=-1001234567890
PRIVATE_CHANNEL_ID=-1009876543210

# Необязательно. Telegram user_id администраторов через запятую.
ADMIN_IDS=123456789

# На Railway подключите Volume с Mount Path /data.
DB_PATH=/data/applications.db
